# ================= LegalEase configuration =================
# 1) Get a free key at https://aistudio.google.com/apikey
# 2) Copy this file to ".env" and paste the key below.
GEMINI_API_KEY=

# Gemini model. "gemini-flash-latest" always points to Google's current Flash model.
# Other options: gemini-2.5-flash, gemini-2.5-pro, gemini-pro-latest
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-pro-latest
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=8192

# true = use a built-in sample document (no API calls). Also automatic when no key is set.
MOCK_MODE=false

# Backend address used by the Streamlit frontend
API_HOST=127.0.0.1
API_PORT=8000
BACKEND_URL=http://127.0.0.1:8000
REQUEST_TIMEOUT=180
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Branding for DOCX / PDF footers
COMPANY_NAME=LegalEase Inc.
COMPANY_EMAIL=contact@legalease.com
